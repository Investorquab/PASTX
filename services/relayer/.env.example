# PASTX bridge relayer — copy this file to services/relayer/.env on your VPS.
# NEVER commit real keys. The real .env is gitignored.

# REQUIRED — private key of the wallet authorised as the BNB gateway relayer.
# It MUST equal BnbBridgeGateway.relayer(), or completeDeposit() reverts.
# The wallet also needs some tBNB to pay gas for the mint transactions.
PASTX_BNB_RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY

# Optional — RPC overrides (built-in testnet defaults are used if omitted)
PORTALDOT_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
BNB_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Optional — contract overrides (defaults = the live testnet deployment)
PASTX_PORTALDOT_ESCROW_ADDRESS=0x024b77EBbF04f48a0d921094f7000b18063bdD69
PASTX_BNB_GATEWAY_ADDRESS=0xd81133c76289Df27105E8aF15579631fE305F9E1

# Optional — polling interval in milliseconds
PASTX_RELAY_POLL_MS=4000
