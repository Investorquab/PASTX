# TESTNET ONLY. Copy to .env in this directory; .env is gitignored.
# Keep this file local. Never paste a key or recovery phrase into chat or commit it.
# Portaldot V3 testnet RPC/chain ID; native tPOTv3 decimals are 14.
PORTALDOT_V3_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev

# Set exactly ONE signer source. Do not set both.
PORTALDOT_DEPLOYER_PRIVATE_KEY=
# For SubWallet mnemonic mode, use the phrase that derives the EVM signer you intend to deploy from.
# Hardhat derives m/44'/60'/0'/0/0. Confirm the resulting 0x address matches SubWallet's EVM account.
PORTALDOT_DEPLOYER_MNEMONIC=

# Optional output directory, default deployments/portal-v3-testnet/
# PASTX_DEPLOYMENT_OUTPUT_DIR=./deployments/portal-v3-testnet

# Native Substrate contracts deployment. Reuses PORTALDOT_DEPLOYER_MNEMONIC by default.
PORTALDOT_NATIVE_WS_RPC_URL=wss://test-node-v3.portaldot.dev
PORTALDOT_NATIVE_EXPECTED_CHAIN=PortaldotV3 Test
# Optional: set the verified native 5... address to guard against selecting another account.
PORTALDOT_NATIVE_EXPECTED_ADDRESS=
# Required for deploy/verify: copy the official testnet genesis hash reported by preflight after verifying it.
PORTALDOT_NATIVE_EXPECTED_GENESIS_HASH=
# Protect this amount from deployment spending; default is 1 whole native token.
PORTALDOT_NATIVE_KEEP_RESERVE=1

# Cross-chain prototype only; not needed for the core PASTX market deployment.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BNB_TESTNET_DEPLOYER_PRIVATE_KEY=
PASTX_PORTAL_RELAYER_ADDRESS=
PASTX_BNB_RELAYER_ADDRESS=
PASTX_PORTALDOT_ESCROW_ADDRESS=
PASTX_BNB_GATEWAY_ADDRESS=
PASTX_PORTALDOT_RELAYER_PRIVATE_KEY=
PASTX_BNB_RELAYER_PRIVATE_KEY=
PASTX_PORTALDOT_SCAN_FROM_BLOCK=
PASTX_BNB_SCAN_FROM_BLOCK=
PASTX_RELAY_EXECUTE=false
PASTX_PORTALDOT_CONFIRMATIONS=3
PASTX_BNB_CONFIRMATIONS=3
PASTX_RELAY_POLL_MS=5000
PASTX_RELAY_BATCH_SIZE=100
PASTX_RELAY_CURSOR_FILE=.pastx-relay-cursor.json
PASTX_DEMO_MARKET_SEED_RAW=

# iSwap + iBridge demo. Leave the verification flag false until the raw msg.value/native-unit mapping is checked.
# These values are raw EVM native-value units and MUST be derived only after that check; do not guess.
PASTX_PORTAL_NATIVE_VALUE_SEMANTICS_VERIFIED=false
# Start with 1 raw unit. Only after that passes and official 14-decimal metadata is confirmed, run again at 1000000000000 raw units to establish the exact 0.01 tPOT demo cap.
PASTX_VALUE_PROBE_RAW=1
# Optional absolute report destination; default is deployments/value-probe/latest.json.
PASTX_VALUE_PROBE_REPORT_PATH=
PASTX_ISWAP_NATIVE_RAW_PER_WHOLE_PUSD=
PASTX_ISWAP_MAX_NATIVE_PER_SWAP_RAW=
PASTX_ISWAP_INITIAL_LIQUIDITY_RAW=
PASTX_BRIDGE_MAX_DEPOSIT_RAW=

# The optional master runner writes one combined manifest and addresses file here; leave blank for its default.
PASTX_MASTER_DEPLOYMENT_OUTPUT_DIR=
