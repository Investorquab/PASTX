# TESTNET ONLY. Copy this file to .env in contracts/cross-chain.
# Never commit real private keys or credential-bearing RPC URLs.
# The relayer sends transactions only if PASTX_RELAY_EXECUTE=true.

PORTALDOT_V3_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org

# Deployment signer keys (keep local; do not share in chat).
PORTALDOT_DEPLOYER_PRIVATE_KEY=
BNB_TESTNET_DEPLOYER_PRIVATE_KEY=

# Addresses are printed by deploy scripts; fill only after manual deployment.
PASTX_PORTAL_RELAYER_ADDRESS=
PASTX_BNB_RELAYER_ADDRESS=
PASTX_PORTALDOT_ESCROW_ADDRESS=
PASTX_BNB_GATEWAY_ADDRESS=

# Relayer signer keys should match the relayer addresses configured in both contracts.
# Use testnet-only funded keys; do not reuse a valuable mainnet wallet.
PASTX_PORTALDOT_RELAYER_PRIVATE_KEY=
PASTX_BNB_RELAYER_PRIVATE_KEY=

# Set both scan start blocks to the relevant contract deployment blocks.
PASTX_PORTALDOT_SCAN_FROM_BLOCK=
PASTX_BNB_SCAN_FROM_BLOCK=

# Execution is disabled unless the value is exactly "true".
PASTX_RELAY_EXECUTE=false
PASTX_PORTALDOT_CONFIRMATIONS=3
PASTX_BNB_CONFIRMATIONS=3
PASTX_RELAY_POLL_MS=5000
PASTX_RELAY_BATCH_SIZE=100

# Optional one-time mock liquidity seed, in raw wtPOTv3 units (14 decimals).
# This is simulated test liquidity only and is not redeemable.
PASTX_DEMO_MARKET_SEED_RAW=
