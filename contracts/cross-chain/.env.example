# TESTNET ONLY. Copy to .env in this directory.
# Never paste private keys into chat or commit .env.
# Portaldot V3 Solidity/PolkaVM target, chain ID 420420777, native tPOTv3 decimals 14.
PORTALDOT_V3_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_DEPLOYER_PRIVATE_KEY=
# Optional output directory, default deployments/portal-v3-testnet/
# PASTX_DEPLOYMENT_OUTPUT_DIR=./deployments/portal-v3-testnet

# Cross-chain prototype only; not needed for the core PASTX market deployment.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BNB_TESTNET_DEPLOYER_PRIVATE_KEY=
PASTX_PORTAL_RELAYER_ADDRESS=
PASTX_BNB_RELAYER_ADDRESS=
PASTX_PORTALDOT_ESCROW_ADDRESS=
PASTX_BNB_GATEWAY_ADDRESS=
PASTX_PORTALDOT_RELAYER_PRIVATE_KEY=
PASTX_BNB_RELAYER_PRIVATE_KEY=
PASTX_PORTALDOT_SCAN_FROM_BLOCK=
PASTX_BNB_SCAN_FROM_BLOCK=
PASTX_RELAY_EXECUTE=false
PASTX_PORTALDOT_CONFIRMATIONS=3
PASTX_BNB_CONFIRMATIONS=3
PASTX_RELAY_POLL_MS=5000
PASTX_RELAY_BATCH_SIZE=100
PASTX_RELAY_CURSOR_FILE=.pastx-relay-cursor.json
PASTX_DEMO_MARKET_SEED_RAW=
