# Copy to .env locally. Never put real values in Git.
NODE_ENV=development
PORT=4000

# Market data provider key; keep server-side only.
MARKET_DATA_API_KEY=

# Optional RPC endpoint for the chosen Portaldot environment.
# Confirm network identity and runtime before using for writes.
PORTALDOT_RPC_URL=

# Optional database connection, only when persistence is introduced.
DATABASE_URL=
