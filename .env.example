# Copy to .env locally. Never put real values in Git.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Server-only market data provider key. Never use a VITE_ prefix.
MARKET_DATA_API_KEY=

# Must remain false until your provider account permits client-facing display.
MARKET_DATA_DISPLAY_ENABLED=false

# Read-only identity probe. Default chain ID is the documented V3 testnet ID.
# Set this only after verifying the intended network's official chain ID.
PORTALDOT_EVM_CHAIN_ID=420420777
PORTALDOT_EVM_RPC_URL=
PORTALDOT_EVM_GENESIS_HASH=
PORTALDOT_EVM_CHECKPOINT_BLOCK=
PORTALDOT_EVM_CHECKPOINT_HASH=

# Public TESTNET addresses for the optional cross-chain demo UI; leave blank until deployed and verified.
VITE_PASTX_PORTALDOT_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
VITE_PASTX_BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
VITE_PASTX_PORTALDOT_ESCROW_ADDRESS=
VITE_PASTX_BNB_GATEWAY_ADDRESS=
# Keep false until a manual small-value test confirms native EVM msg.value/decimal semantics on V3.
VITE_PASTX_SOURCE_VALUE_SEMANTICS_VERIFIED=false

# Native Substrate ink! demo. These values are public; leave contract address/hash blank until deployment
# is confirmed and the expected genesis hash has been independently verified.
VITE_PASTX_NATIVE_WS_RPC_URL=wss://test-node-v3.portaldot.dev
VITE_PASTX_NATIVE_CONTRACT_ADDRESS=
VITE_PASTX_NATIVE_EXPECTED_GENESIS_HASH=

DATABASE_URL=

# Optional on-chain asset registry. Keep this server-side.
PASTX_ONCHAIN_ASSET_REGISTRY_JSON=
PASTX_ONCHAIN_ASSET_REGISTRY_SHA256=
PASTX_ONCHAIN_ASSET_REGISTRY_SIGNATURE=
PASTX_ONCHAIN_ASSET_REGISTRY_PUBLIC_KEY=
